{
    "name": "danog/laravel-telegram",
    "description": "High-performance Telegram MTProto client, PostgreSQL schema mirror, and Mini App platform for Laravel",
    "type": "library",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/events": "^10.0|^11.0",
        "illuminate/redis": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Danog\\LaravelTelegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danog\\LaravelTelegram\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Danog\\LaravelTelegram\\TelegramServiceProvider"
            ]
        }
    }
}
