{
    "name": "rezarezaei/laravel-telegram",
    "description": "High-performance, stateless MTProto 2.0 Telegram client and Mini App platform for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Reza Rezaei"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rezarezaei\\LaravelTelegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rezarezaei\\LaravelTelegram\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rezarezaei\\LaravelTelegram\\TelegramServiceProvider"
            ],
            "aliases": {
                "Telegram": "Rezarezaei\\LaravelTelegram\\Facades\\Telegram"
            }
        }
    }
}
