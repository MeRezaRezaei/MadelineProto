use danog\MadelineProto\API;
use danog\MadelineProto\Db\Migrations;
use danog\MadelineProto\Db\PdoDriver;
use danog\MadelineProto\Db\RelationalStore;
use danog\MadelineProto\Sync\BackfillWorker;
use danog\MadelineProto\Sync\FetchQueue;
use danog\MadelineProto\Sync\SyncTargets;

require __DIR__ . '/../vendor/autoload.php';

// ── argument parsing ────────────────────────────────────────────────────────
$args = array_slice($argv, 1);
$subcommand = null;
$dsn = null;
$redis = null;
$peer = null;
$type = 'channel';
$since = null;
$quota = 100;
$session = 'madeline-backfill';

foreach ($args as $arg) {
    if (str_starts_with($arg, '--dsn=')) {
        $dsn = substr($arg, 6);
    } elseif (str_starts_with($arg, '--redis=')) {
        $redis = substr($arg, 8);
    } elseif (str_starts_with($arg, '--peer=')) {
        $peer = (int) substr($arg, 7);
    } elseif (str_starts_with($arg, '--type=')) {
        $type = substr($arg, 7);
    } elseif (str_starts_with($arg, '--since=')) {
        $since = substr($arg, 8);
    } elseif (str_starts_with($arg, '--quota=')) {
        $quota = (int) substr($arg, 8);
    } elseif (str_starts_with($arg, '--session=')) {
        $session = substr($arg, 10);
    } elseif (!str_starts_with($arg, '-')) {
        $subcommand = $arg;
    }
}

// Fallback to environment variables.
$dsn ??= ($_ENV['MADLINE_DSN'] ?? getenv('MADLINE_DSN')) ?: null;
$redis ??= ($_ENV['MADLINE_REDIS'] ?? getenv('MADLINE_REDIS')) ?: null;

if ($subcommand !== 'enqueue' && $subcommand !== 'run') {
    fwrite(STDERR, "Usage: madeline-backfill enqueue --dsn=... --redis=... --peer=<id> [--type=channel] [--since=<epoch>|--since=all]\n");
    fwrite(STDERR, "       madeline-backfill run --dsn=... --redis=... [--quota=<n>] [--session=<file>]\n");
    exit(1);
}

if ($dsn === null || $dsn === '') {
    fwrite(STDERR, "Error: --dsn or MADLINE_DSN is required.\n");
    exit(1);
}
if ($redis === null || $redis === '') {
    fwrite(STDERR, "Error: --redis or MADLINE_REDIS is required.\n");
    exit(1);
}

$driver = new PdoDriver($dsn);
(new Migrations($driver))->migrate();

// ── enqueue ─────────────────────────────────────────────────────────────────
if ($subcommand === 'enqueue') {
    if ($peer === null || $peer <= 0) {
        fwrite(STDERR, "Error: --peer=<id> is required for enqueue.\n");
        exit(1);
    }

    $untilDate = match ($since) {
        null, '' => time() - 31557600, // default: 1 year back
        'all' => null,                 // all-time history
        default => (int) $since,       // explicit epoch
    };

    (new SyncTargets($driver))->add($peer, $type, $untilDate);
    (new FetchQueue($driver))->enqueue($peer, $untilDate);

    echo "Enqueued backfill job for peer {$peer} (type={$type}, since=" . ($untilDate === null ? 'all' : $untilDate) . ")\n";
    exit(0);
}

// ── run one pass (daemon calls this periodically) ───────────────────────────
$store = new RelationalStore($driver);
$queue = new FetchQueue($driver);
$api = new API($session);
$worker = new BackfillWorker($store, $queue, BackfillWorker::getHistoryFetcher($api));
$worker->run($quota);

echo "Backfill pass complete.\n";
exit(0);
