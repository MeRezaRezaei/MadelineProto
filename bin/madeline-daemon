 * MadelineProto is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
 * See the GNU Affero General Public License for more details.
 * You should have received a copy of the GNU General Public License along with MadelineProto.
 * If not, see <http://www.gnu.org/licenses/>.
 *
 * @author    Daniil Gentili <daniil@daniil.it>
 * @copyright 2016-2025 Daniil Gentili <daniil@daniil.it>
 * @license   https://opensource.org/licenses/AGPL-3.0 AGPLv3
 * @link https://docs.madelineproto.xyz MadelineProto documentation
 */

use danog\MadelineProto\Accounts\AccountManager;
use danog\MadelineProto\API;
use danog\MadelineProto\Daemon\Daemon;
use danog\MadelineProto\Db\Cache;
use danog\MadelineProto\Db\Migrations;
use danog\MadelineProto\Db\PdoDriver;
use danog\MadelineProto\Db\RelationalStore;
use danog\MadelineProto\Events\EventBus;
use danog\MadelineProto\Sync\BackfillWorker;
use danog\MadelineProto\Sync\FetchQueue;
use danog\MadelineProto\Sync\NullAccountDataProvider;
use danog\MadelineProto\Sync\SyncLoop;
use danog\MadelineProto\Sync\SyncTargets;
use danog\MadelineProto\Sync\UpdateHandler;
use Revolt\EventLoop;

require __DIR__ . '/../vendor/autoload.php';

$pidFile = '/tmp/madeline-daemon.pid';

// ── argument parsing ────────────────────────────────────────────────────────
$args = array_slice($argv, 1);
$subcommand = 'start';
$dsn = null;
$redis = null;
$session = null;

foreach ($args as $arg) {
    if (str_starts_with($arg, '--dsn=')) {
        $dsn = substr($arg, 6);
    } elseif (str_starts_with($arg, '--redis=')) {
        $redis = substr($arg, 8);
    } elseif (str_starts_with($arg, '--session=')) {
        $session = substr($arg, 10);
    } elseif ($arg === 'start' || $arg === 'stop' || $arg === 'status') {
        $subcommand = $arg;
    } elseif (!str_starts_with($arg, '-')) {
        $subcommand = $arg;
    }
}

// Fallback to environment variables.
$dsn ??= $_ENV['MADLINE_DSN'] ?? getenv('MADLINE_DSN') ?: null;
$redis ??= $_ENV['MADLINE_REDIS'] ?? getenv('MADLINE_REDIS') ?: null;
$session ??= $_ENV['MADLINE_SESSION'] ?? getenv('MADLINE_SESSION') ?: null;

// ── status ──────────────────────────────────────────────────────────────────
if ($subcommand === 'status') {
    if (file_exists($pidFile) && (int) file_get_contents($pidFile) > 0) {
        $pid = (int) file_get_contents($pidFile);
        if (posix_kill($pid, 0)) {
            echo "Daemon running (PID {$pid})\n";
            exit(0);
        }
        echo "PID file stale (PID {$pid} not alive)\n";
        exit(1);
    }
    echo "Daemon not running\n";
    exit(1);
}

// ── stop ────────────────────────────────────────────────────────────────────
if ($subcommand === 'stop') {
    if (!file_exists($pidFile)) {
        echo "No PID file; daemon not running\n";
        exit(0);
    }
    $pid = (int) file_get_contents($pidFile);
    if ($pid <= 0 || !posix_kill($pid, 0)) {
        echo "PID {$pid} not alive or already stopped\n";
        @unlink($pidFile);
        exit(0);
    }
    posix_kill($pid, SIGTERM);
    echo "Sent SIGTERM to PID {$pid}; waiting for exit…\n";

    // Poll until the process stops, max 5 seconds.
    $deadline = time() + 5;
    while (time() < $deadline) {
        if (!posix_kill($pid, 0)) {
            echo "PID {$pid} exited\n";
            @unlink($pidFile);
            exit(0);
        }
        usleep(100_000); // 100 ms
    }
    echo "Warning: PID {$pid} did not exit within 5 s; unlinking PID file anyway\n";
    @unlink($pidFile);
    exit(1);
}

// ── start ───────────────────────────────────────────────────────────────────
if ($dsn === null || $dsn === '') {
    fwrite(STDERR, "Error: --dsn or MADLINE_DSN is required.\n");
    exit(1);
}
if ($redis === null || $redis === '') {
    fwrite(STDERR, "Error: --redis or MADLINE_REDIS is required.\n");
    exit(1);
}

$driver = new PdoDriver($dsn);
(new Migrations($driver))->migrate();
$store = new RelationalStore($driver);
$accounts = new AccountManager($store);
$cache = new Cache($redis);

// Live hot path: TG updates → UpdateHandler → (store + cache + Redis bus).
$bus = new EventBus($redis, $redis, [], $redis);
$handler = new UpdateHandler($store, $cache, $bus, new SyncTargets($driver));
// Real TG updates arrive via MadelineProto's EventHandler calling $handler->process(...).

// Gradual backfill: queue-driven, quota-sliced, drained by the watcher below.
// The history fetcher needs a logged-in MadelineProto session; without one the
// loop must not run: an empty-page fetcher makes BackfillWorker treat every
// claimed job as exhausted history and delete it (silent job loss).
$backfill = null;
if ($session !== null && $session !== '') {
    $backfill = new BackfillWorker(
        $store,
        new FetchQueue($driver),
        BackfillWorker::getHistoryFetcher(new API($session)),
        100,
    );
}

// SyncLoop keeps periodic cache invalidation; the live update path above
// supersedes the null provider for real traffic (kept for SyncLoop's shape).
$sync = new SyncLoop($accounts, $store, $cache, new NullAccountDataProvider());

$daemon = new Daemon($driver, $cache, $accounts, $sync);

// Write PID file.
file_put_contents($pidFile, (string) getmypid());

// Daemon::boot() installs signal watchers (via Revolt's EventLoop::onSignal);
// EventLoop::run() drives the sync loop and dispatches signals. It returns
// once the daemon stops (all referenced watchers cancelled in stop()).
$daemon->boot();

// Backfill: drain one quota-sliced pass every 60 s. The repeat watcher is
// unreferenced so it never keeps the event loop alive; while the daemon runs
// the referenced sync-loop + signal watchers do, so it still ticks. On SIGTERM
// those are cancelled, EventLoop::run() returns, and PID cleanup executes.
if ($backfill !== null) {
    $backfillWatcher = EventLoop::repeat(60.0, static function () use ($backfill): void {
        try {
            $backfill->run(100, 10);
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Backfill pass failed: ' . $e->getMessage() . \PHP_EOL);
        }
    });
    EventLoop::unreference($backfillWatcher);
} else {
    fwrite(STDERR, "Warning: --session/MADLINE_SESSION not given; backfill loop disabled (queued jobs are kept for bin/madeline-backfill run).\n");
}

EventLoop::run();

// Clean up the PID file after a clean shutdown.
@unlink($pidFile);
exit(0);
