#!/usr/bin/env php
<?php

declare(strict_types=1);

use MadelineMcp\ApiClient;
use MadelineMcp\McpServer;
use MadelineMcp\ToolCatalog;

require __DIR__.'/../../vendor/autoload.php';

spl_autoload_register(static function (string $class): void {
    $prefix = 'MadelineMcp\\';
    if (\str_starts_with($class, $prefix)) {
        $rel = \str_replace('\\', '/', \substr($class, \strlen($prefix)));
        require __DIR__.'/../src/'.$rel.'.php';
    }
});

$args = array_slice($argv, 1);
$session = null;
$dsn = null;

foreach ($args as $arg) {
    if (str_starts_with($arg, '--session=')) {
        $session = substr($arg, 10);
    } elseif (str_starts_with($arg, '--dsn=')) {
        $dsn = substr($arg, 6);
    }
}

$session ??= (string) getenv('SESSION') ?: 'madeline-mcp';
$dsn ??= (string) (getenv('MADELINE_DSN') ?: (getenv('MADLINE_DSN') ?: (getenv('DATABASE_URL') ?: ''))) ?: null;

$client = new ApiClient($session, $dsn);
$server = new McpServer($client, new ToolCatalog($client));

$server->run();